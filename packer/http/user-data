#cloud-config
autoinstall:
  version: 1

  # Kosongkan supaya TIDAK ADA layar konfirmasi interaktif sama sekali -
  # ini yang membuat instalasi benar-benar unattended untuk kebutuhan Packer.
  interactive-sections: []

  locale: en_US.UTF-8
  keyboard:
    layout: us
    variant: ""

  identity:
    hostname: nusalog-srv
    username: packer
    # Hash SHA-512 untuk password sementara Packer (lihat variables.pkr.hcl
    # ssh_password). Akun ini hanya dipakai selama provisioning.
    password: "$6$packerlab$QENRf21v0svnOd8aUDfx9w/9JwDqrHOhAvV10LZgXt4nKWB8L/.1ZqLK63uX2wMt3m13/zWzf8WqQ5SUIMipp/"

  ssh:
    install-server: true
    allow-pw: true
    authorized-keys: []

  storage:
    layout:
      name: direct

  packages:
    - openssh-server

  updates: security

  late-commands:
    - echo 'packer ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/packer-temp
    - chmod 0440 /target/etc/sudoers.d/packer-temp

  shutdown: poweroff
